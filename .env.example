# ── Supabase ─────────────────────────────────────────────
# https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never exposed to client

# ── Naver News Search API ────────────────────────────────
# https://developers.naver.com/apps  (검색 > 뉴스)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── LLM (card generation) ────────────────────────────────
# Any provider; wire up in lib/ai.ts
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# NOTE: with no keys set, /api/search and /api/generate return
# realistic MOCK data so the app runs end-to-end out of the box.
