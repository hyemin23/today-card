# ── Supabase ─────────────────────────────────────────────
# https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never exposed to client

# ── News collection ──────────────────────────────────────
# 키가 필요 없습니다. /api/search 가 Daum 뉴스 검색 페이지를 직접
# 가져와 파싱(lib/news.ts)하고, 막히면 Google News RSS → 목업으로
# 폴백합니다. 별도 설정 없이 실데이터로 동작합니다.

# ── LLM (card generation) ────────────────────────────────
# Any provider; wire up in lib/ai.ts
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# NOTE: 검색은 키 없이 실데이터로 동작합니다. LLM 키가 없으면
# /api/generate 만 목업 카드를 반환합니다.
